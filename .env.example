# Copy to .env and fill with real values. No secrets belong in source control.

# Entra ID tenant and app registration (dummy GUIDs for documentation only)
TENANT_ID=00000000-0000-0000-0000-000000000001
CLIENT_ID=00000000-0000-0000-0000-000000000002

# Path to PFX used for certificate-based Graph auth (example path only)
GRAPH_CERT_PATH=C:\path\to\graph-client.pfx
# GRAPH_CERT_PASSWORD=  # set only if the PFX is password-protected; leave unset when unused

# Optional: client secret auth (prefer certificate where possible)
# CLIENT_SECRET=

# Report output directory
OUTPUT_DIR=./out

# Chapter toggles (defaults as shown)
CHAPTER_GUESTS=true
CHAPTER_PRIVILEGED=true
CHAPTER_APPLICATIONS=true
CHAPTER_DEVICES=true
CHAPTER_SIGNIN_RISK=false
